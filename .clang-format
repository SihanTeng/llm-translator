# Matches the existing Qt-style code in this repo:
# 4-space indent, attached braces, pointer attached to the name.
BasedOnStyle: WebKit
Language: Cpp
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
PointerAlignment: Right
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
BreakBeforeBraces: Attach
SpaceBeforeParens: ControlStatements
